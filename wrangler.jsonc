/**
 * Cloudflare Worker with static assets.
 * The site is built to ./dist; the Worker in ./worker answers /api/* and serves everything else.
 * https://developers.cloudflare.com/workers/static-assets/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "home",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-25",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	// Keep variables set in the Cloudflare dashboard (e.g. LASTFM_USER) on each deploy.
	"keep_vars": true,
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
	/**
	 * To turn on views and pats, create the D1 database (see README) and add:
	 * "d1_databases": [{ "binding": "DB", "database_name": "home", "database_id": "<id from wrangler d1 create>" }]
	 */
}
