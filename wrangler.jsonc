/**
 * Cloudflare Worker with static assets.
 * The site is built to ./dist; the Worker in ./worker answers /api/* and serves everything else.
 * https://developers.cloudflare.com/workers/static-assets/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "home",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-25",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	// Keep variables set in the Cloudflare dashboard (e.g. LASTFM_USER) on each deploy.
	"keep_vars": true,
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// D1 database for the view and pat counters (table: migrations/0001_init.sql).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "home",
			"database_id": "9c591914-f8fb-419b-9636-9ecb84b4b36d"
		}
	]
}
