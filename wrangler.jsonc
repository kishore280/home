/**
 * Cloudflare Worker with static assets.
 * The site is built to ./dist; the Worker in ./worker answers /api/* and serves everything else.
 * https://developers.cloudflare.com/workers/static-assets/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "home",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-25",
	// Node.js APIs for google-photos-album-image-url-fetch (its HTTP client, gaxios), used by /api/photos.
	// https://developers.cloudflare.com/workers/runtime-apis/nodejs/
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": ["/api/*", "/p", "/p/*"]
	},
	// Serve on home.<account>.workers.dev; no per-version preview URLs.
	"workers_dev": true,
	"preview_urls": false,
	// Keep variables set in the Cloudflare dashboard (e.g. the SCROBBLE_TOKEN secret) on each deploy.
	"keep_vars": true,
	// Plain-text variables: only values that are not secret. Secrets (SCROBBLE_TOKEN, PURGE_TOKEN) are
	// set in the dashboard, never here.
	"vars": {
		// The kichoow.com zone, for "refresh photos" (purge by Cache-Tag, worker/photos.ts). An ID, not a
		// secret; the PURGE_TOKEN secret is what allows the purge.
		"ZONE_ID": "63ee1d0d39bb264952f3388f375f4eb4"
	},
	// Logs and traces for the Worker (/api/* only; static files do not run it).
	// Free plan: 200,000 events/day with 3 days retention; past that, 1% sampling, no bill.
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"redact_query_string": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		}
	},
	"upload_source_maps": true,
	// D1 database: view and pat counters, and the latest song (tables: migrations/).
	// Pastes (worker/paste.ts): KV deletes each one by itself when its time is over (expirationTtl).
	"kv_namespaces": [
		{
			"binding": "PASTES",
			"id": "df1072fd0ac2419c96509665622ea392"
		}
	],
	// 5 new pastes a minute per visitor (Workers Rate Limiting; namespace_id is any number unique in
	// the account).
	"ratelimits": [
		{
			"name": "PASTE_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "home",
			"database_id": "9c591914-f8fb-419b-9636-9ecb84b4b36d"
		}
	]
}
