{
  "name": "home",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs && node scripts/sw.mjs",
    "lint": "oxlint",
    "audit": "npm run build && playwright test",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "og": "node scripts/og/generate.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "cmdk": "^1.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "google-photos-album-image-url-fetch": "^3.2.0",
    "react": "^19.2.8",
    "react-activity-calendar": "^3.2.1",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.6",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "beasties": "^0.5.4",
    "gifenc": "^1.0.3",
    "microformats-parser": "^2.0.6",
    "opentype.js": "^2.0.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-csp-guard": "^4.0.1",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.142.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
