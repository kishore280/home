# Cloudflare Workers static asset headers. Not served; parsed by Cloudflare.
# https://developers.cloudflare.com/workers/static-assets/headers/

# Basic security headers on every static response.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # The main CSP is a <meta> tag (vite-plugin-csp-guard); frame-ancestors works only as a header.
  Content-Security-Policy: frame-ancestors 'none'
  # Speculation Rules: prefetch a same-site page when a link is hovered or touched, so it opens
  # at once. Prefetch only (no prerender), so no page runs early and no view is counted.
  Speculation-Rules: "/speculationrules.json"
  # AI tools find the site's summary from any page (as yagiz.co and thejasonsamuel.com do).
  Link: </llms.txt>; rel="describedby"; type="text/plain"

/speculationrules.json
  Content-Type: application/speculationrules+json

# 88x31 buttons for button-wall tools (seo.ts): readable from any site, and its GIFs too.
/.well-known/button.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

# Vite puts a content hash in these file names, so they never change: cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 88x31 buttons and the favicon keep their names, so cache for a day and then revalidate.
/button*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *
/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/sw.js
  Cache-Control: no-cache
/icon-512.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Markdown copies of the pages and posts and llms-full.txt (seo.ts) are for AI tools: open to read,
# but kept out of search results, where the HTML page is the one to show.
/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
/llms-full.txt
  X-Robots-Tag: noindex
